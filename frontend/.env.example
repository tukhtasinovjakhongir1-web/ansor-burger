# Neon PostgreSQL ulanishi
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Telegram bot tokeni (@BotFather) — buyurtma xabarlari va initData tekshiruvi uchun
BOT_TOKEN=

# Admin panelga kirish paroli (botda /admin PAROL uchun ham shu parol)
ADMIN_PASSWORD=

# Admin sessiyasini imzolash uchun tasodifiy uzun satr
SESSION_SECRET=

# Bot username (@ belgisisiz) — profil sahifasidagi havola uchun
NEXT_PUBLIC_BOT_USERNAME=ansor_burger_bot

# Ixtiyoriy: saytning to'liq manzili (Vercel'da avtomatik aniqlanadi)
# APP_URL=https://ansor-burger.vercel.app

# Ixtiyoriy: xabar oladigan qo'shimcha admin Telegram ID lari (vergul bilan)
# ADMIN_CHAT_IDS=
