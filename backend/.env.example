# Telegram bot tokeni (@BotFather)
BOT_TOKEN=

# Neon PostgreSQL ulanishi (frontend bilan bir xil baza)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Mini App manzili (Vercel'dagi frontend), masalan https://ansor-burger.vercel.app
WEBAPP_URL=

# Botda "/admin PAROL" bilan admin bo'lish uchun (frontend ADMIN_PASSWORD bilan bir xil qiling)
ADMIN_PASSWORD=

# Ixtiyoriy: oldindan belgilangan admin Telegram ID lari (vergul bilan)
ADMIN_IDS=

# Webhook rejimi (Vercel) uchun: https://<backend-loyiha>.vercel.app/api/webhook
WEBHOOK_URL=
# Tasodifiy satr — Telegram so'rovlarini tekshirish uchun
WEBHOOK_SECRET=
